---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title="Equipos industriales en acero inoxidable"
  description="Neveras, vitrinas refrigeradas, freidoras, estufas y soluciones a medida para cocinas profesionales."
  noindex
>
  <section id="inicio" class="relative isolate overflow-hidden bg-white">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 -z-10 hidden w-[48%] bg-gradient-to-bl from-brand-50 via-steel-50 to-white lg:block"
    ></div>

    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
          Equipamiento industrial en acero inoxidable
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight text-steel-950 text-balance sm:text-5xl lg:text-6xl">
          Equipos para cocinas profesionales
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-steel-600">
          Neveras, vitrinas refrigeradas, freidoras, estufas y soluciones a medida para distintas
          necesidades de refrigeración, cocción y preparación.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/productos/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Explorar catálogo
          </a>
          <a
            href="/servicios/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-steel-200 bg-white px-5 py-3 text-sm font-semibold text-steel-800 transition-colors hover:border-steel-300 hover:bg-steel-50"
          >
            Conocer servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="presentacion" class="border-t border-steel-100 bg-steel-50">
    <div class="mx-auto grid max-w-6xl gap-5 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:px-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">{SITE.name}</p>
        <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-steel-950 sm:text-3xl">
          Equipamiento y acompañamiento para cada proyecto
        </h2>
      </div>
      <p class="text-base leading-7 text-steel-600 sm:text-lg sm:leading-8">
        {SITE.name} crea equipos industriales en acero inoxidable y acompaña a sus clientes con
        fabricación a medida, instalación, mantenimiento preventivo y correctivo, asesoría y
        equipamiento integral.
      </p>
    </div>
  </section>
</BaseLayout>
