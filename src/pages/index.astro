---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ProductCard from "../components/ProductCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { PRODUCT_CATEGORIES } from "../config/catalog";
import { FAQS } from "../config/faqs";
import { SERVICES } from "../config/services";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";
import { buildWhatsAppUrl } from "../lib/whatsapp";

const products = await getCollection("products", ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true,
);
const featuredProducts = products.filter((product) => product.data.featured).slice(0, 3);

const homeServiceSlugs = new Set([
  "fabricacion-a-medida",
  "instalacion",
  "mantenimiento",
  "equipamiento-integral",
]);
const homeServices = SERVICES.filter((service) => homeServiceSlugs.has(service.slug));

const homeFaqQuestions = [
  "¿Qué productos ofrecen?",
  "¿Los productos tienen precio publicado?",
  "¿Cómo solicito una cotización?",
];
const homeFaqs = FAQS.filter((faq) => homeFaqQuestions.includes(faq.question));
const quoteUrl = buildWhatsAppUrl("Hola, quisiera consultar sobre equipamiento para mi cocina.");
---

<BaseLayout
  title="Equipos industriales en acero inoxidable"
  description="Neveras, vitrinas refrigeradas, freidoras, estufas y soluciones a medida para cocinas profesionales."
  noindex
>
  <section id="inicio" class="relative isolate overflow-hidden bg-white">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 -z-10 hidden w-[48%] bg-gradient-to-bl from-brand-50 via-steel-50 to-white lg:block"
    ></div>

    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
          Equipamiento industrial en acero inoxidable
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight text-steel-950 text-balance sm:text-5xl lg:text-6xl">
          Equipos para cocinas profesionales
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-steel-600">
          Neveras, vitrinas refrigeradas, freidoras, estufas y soluciones a medida para distintas
          necesidades de refrigeración, cocción y preparación.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={withBase("/productos/")}
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Explorar catálogo
          </a>
          <a
            href={withBase("/servicios/")}
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-steel-200 bg-white px-5 py-3 text-sm font-semibold text-steel-800 transition-colors hover:border-steel-300 hover:bg-steel-50"
          >
            Conocer servicios
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="categorias" aria-labelledby="categories-title" class="bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Catálogo</p>
        <h2
          id="categories-title"
          class="mt-3 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl"
        >
          Explora por categoría
        </h2>
        <p class="mt-3 text-base leading-7 text-steel-600">
          Encuentra equipos para refrigeración, cocción, extracción y mobiliario.
        </p>
      </div>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {PRODUCT_CATEGORIES.map((category, index) => (
          <CategoryCard category={category} index={index} />
        ))}
      </ul>
    </div>
  </section>

  {featuredProducts.length > 0 && (
    <section id="destacados" aria-labelledby="featured-title" class="bg-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Catálogo</p>
            <h2
              id="featured-title"
              class="mt-3 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl"
            >
              Productos destacados
            </h2>
            <p class="mt-3 text-base leading-7 text-steel-600">
              Una selección de equipos para refrigeración, cocción y extracción.
            </p>
          </div>
          <a
            href={withBase("/productos/")}
            class="text-sm font-semibold text-brand-900 hover:text-brand-700"
          >
            Ver todos los productos →
          </a>
        </div>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </ul>
      </div>
    </section>
  )}

  <section
    id="servicios"
    aria-labelledby="services-home-title"
    class="border-t border-steel-200 bg-steel-50"
  >
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Servicios</p>
          <h2
            id="services-home-title"
            class="mt-3 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl"
          >
            Acompañamiento en cada etapa
          </h2>
          <p class="mt-3 text-base leading-7 text-steel-600">
            Fabricación, instalación, mantenimiento y equipamiento integral para tu proyecto.
          </p>
        </div>
        <a
          href={withBase("/servicios/")}
          class="text-sm font-semibold text-brand-900 hover:text-brand-700"
        >
          Ver todos los servicios →
        </a>
      </div>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {homeServices.map((service, index) => (
          <ServiceCard
            service={service}
            index={index}
            href={
              service.detailPage
                ? withBase(service.detailPage)
                : withBase(`/servicios/#${service.slug}`)
            }
          />
        ))}
      </ul>
    </div>
  </section>

  <section id="presentacion" class="border-t border-steel-100 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid gap-5 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">{SITE.name}</p>
          <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-steel-950 sm:text-3xl">
            Equipamiento y acompañamiento para cada proyecto
          </h2>
        </div>
        <p class="text-base leading-7 text-steel-600 sm:text-lg sm:leading-8">
          {SITE.name} crea equipos industriales en acero inoxidable y acompaña a sus clientes con
          fabricación a medida, instalación, mantenimiento preventivo y correctivo, asesoría y
          equipamiento integral.
        </p>
      </div>

      <ul aria-label="Diferenciales de Industrias Vany" class="mt-10 grid gap-4 sm:grid-cols-3">
        {[
          {
            title: "Acero inoxidable",
            description:
              "Equipamiento pensado para el uso intensivo y la limpieza que exige una cocina profesional.",
          },
          {
            title: "Fabricación a medida",
            description:
              "Adaptamos equipos y soluciones al espacio y a la operación de cada proyecto.",
          },
          {
            title: "Acompañamiento directo",
            description:
              "Acompañamos la consulta, la definición y la puesta en marcha del equipamiento.",
          },
        ].map((item, index) => (
          <li class="rounded-xl border border-steel-200 bg-white p-5">
            <p class="font-display text-sm font-semibold text-brand-700">0{index + 1}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-steel-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    id="preguntas"
    aria-labelledby="home-faq-title"
    class="border-t border-steel-200 bg-white"
  >
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
            Preguntas frecuentes
          </p>
          <h2
            id="home-faq-title"
            class="mt-3 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl"
          >
            Respuestas rápidas
          </h2>
          <p class="mt-3 text-base leading-7 text-steel-600">
            Lo que más nos consultan antes de empezar un proyecto.
          </p>
        </div>
        <a
          href={withBase("/preguntas-frecuentes/")}
          class="text-sm font-semibold text-brand-900 hover:text-brand-700"
        >
          Ver todas las preguntas →
        </a>
      </div>

      <div class="mt-8 max-w-3xl divide-y divide-steel-200 rounded-xl border border-steel-200 bg-white px-4 sm:px-6">
        {homeFaqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-medium text-steel-950">
              <span>{faq.question}</span>
              <span
                aria-hidden="true"
                class="shrink-0 text-xl font-light text-steel-400 transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 max-w-3xl pr-6 text-sm leading-6 text-steel-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-900 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">
          ¿Necesitas equipar tu cocina?
        </h2>
        <p class="mt-2 text-brand-100">
          Contanos qué necesitas y te respondemos con la información disponible.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        {quoteUrl ? (
          <a
            href={quoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-50"
          >
            Consultar por WhatsApp
          </a>
        ) : import.meta.env.DEV ? (
          <span class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm text-white">
            WhatsApp pendiente de configurar
          </span>
        ) : null}
        <a
          href={withBase("/contacto/")}
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/20"
        >
          Ir a Contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
