---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FAQ_CATEGORIES, FAQS } from "../../config/faqs";
import { buildFaqSchema } from "../../lib/structured-data";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

const quoteUrl = buildWhatsAppUrl("Hola, tengo una consulta sobre Industrias Vany.");
const faqSchema = buildFaqSchema(FAQS);
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Respuestas sobre productos, cotizaciones, servicios, mantenimiento y proyectos de equipamiento en acero inoxidable de Industrias Vany."
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-steel-500">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-steel-950">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-steel-700">
            Preguntas frecuentes
          </li>
        </ol>
      </nav>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">
        Preguntas frecuentes
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
        Respuestas antes de empezar
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-steel-600 sm:text-lg">
        Información sobre productos, cotizaciones, servicios y proyectos de equipamiento.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="space-y-10">
      {FAQ_CATEGORIES.map((category) => {
        const items = FAQS.filter((item) => item.category === category);
        const headingId = `faq-${category.toLowerCase().replaceAll(" ", "-").replace("ó", "o")}`;

        return (
          items.length > 0 && (
            <section aria-labelledby={headingId}>
              <h2
                id={headingId}
                class="font-display text-2xl font-semibold tracking-tight text-steel-950"
              >
                {category}
              </h2>
              <div class="mt-4 divide-y divide-steel-200 rounded-xl border border-steel-200 bg-white px-4 sm:px-6">
                {items.map((item) => (
                  <details class="group py-4">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-medium text-steel-950">
                      <span>{item.question}</span>
                      <span
                        aria-hidden="true"
                        class="shrink-0 text-xl font-light text-steel-400 transition-transform group-open:rotate-45"
                      >
                        +
                      </span>
                    </summary>
                    <p class="mt-3 max-w-3xl pr-6 text-sm leading-6 text-steel-600">
                      {item.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )
        );
      })}
    </div>

    <div class="mt-12 rounded-xl border border-steel-200 bg-brand-900 p-6 text-white sm:p-8">
      <h2 class="font-display text-2xl font-semibold tracking-tight">
        ¿No encontraste tu respuesta?
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-brand-100">
        Escribinos y te respondemos con la información que necesitas.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        {quoteUrl ? (
          <a
            href={quoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-50"
          >
            Consultar por WhatsApp
          </a>
        ) : import.meta.env.DEV ? (
          <span class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm text-white">
            WhatsApp pendiente de configurar
          </span>
        ) : null}
        <a
          href="/contacto/"
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/20"
        >
          Ir a Contacto
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
