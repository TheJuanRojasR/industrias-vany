---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import ServiceCard from "../../components/ServiceCard.astro";
import { SERVICES } from "../../config/services";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import { buildServiceSchema } from "../../lib/service-schema";

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const quoteUrl = buildWhatsAppUrl(
  "Hola, quisiera información sobre los servicios de Industrias Vany.",
);
const serviceSchema = buildServiceSchema({
  name: "Servicios de equipamiento industrial",
  description:
    "Fabricación, instalación, mantenimiento y equipamiento integral de cocinas profesionales.",
  url: canonical.toString(),
});
---

<BaseLayout
  title="Servicios"
  description="Fabricación a medida, instalación, mantenimiento preventivo y correctivo, asesoría, equipamiento integral, repuestos, transporte, capacitación y trabajos en acero inoxidable."
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-steel-500">
        <ol class="flex items-center gap-2">
          <li>
            <a href={withBase("/")} class="hover:text-steel-950">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-steel-700">
            Servicios
          </li>
        </ol>
      </nav>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Servicios</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
        Acompañamiento para equipar tu cocina profesional
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-steel-600 sm:text-lg">
        Fabricación, instalación, mantenimiento y equipamiento integral en acero inoxidable.
        Consultanos por el servicio que necesitas.
      </p>
    </div>
  </section>

  <section aria-labelledby="services-title" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 id="services-title" class="sr-only">
      Servicios
    </h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service, index) => (
        <ServiceCard service={service} index={index} />
      ))}
    </ul>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    {SERVICES.map((service) => (
      <section
        id={service.slug}
        class="scroll-mt-24 border-t border-steel-200 py-10 first:border-t-0"
      >
        <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">Servicio</p>
            <h2 class="mt-2 font-display text-2xl font-semibold tracking-tight text-steel-950 sm:text-3xl">
              {service.name}
            </h2>
          </div>
          <div>
            <p class="text-base leading-7 text-steel-600">{service.description}</p>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
              {service.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm leading-6 text-steel-700">
                  <span
                    aria-hidden="true"
                    class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500"
                  />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            {service.detailPage && (
              <a
                href={withBase(service.detailPage)}
                class="mt-5 inline-flex text-sm font-semibold text-brand-900 hover:text-brand-700"
              >
                Ver página de {service.name}
              </a>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="bg-brand-900 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-12 sm:px-6 lg:flex-row lg:items-center lg:px-8">
      <div>
        <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">
          ¿Necesitas asesoramiento para tu proyecto?
        </h2>
        <p class="mt-2 text-brand-100">Contanos qué necesitas y te respondemos.</p>
      </div>
      {quoteUrl ? (
        <a
          href={quoteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-50"
        >
          Consultar por WhatsApp
        </a>
      ) : import.meta.env.DEV ? (
        <span class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm text-white">
          WhatsApp pendiente de configurar
        </span>
      ) : null}
    </div>
  </section>
</BaseLayout>
