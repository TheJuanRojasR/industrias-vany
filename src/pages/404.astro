---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio o explora el catálogo de Industrias Vany."
  noindex
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-28">
    <p
      aria-hidden="true"
      class="font-display text-7xl font-semibold tracking-tight text-brand-500 sm:text-8xl"
    >
      404
    </p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl">
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-lg text-base leading-7 text-steel-600">
      La página que buscas no existe o cambió de dirección. Puedes volver al inicio o continuar
      desde el catálogo.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={withBase("/")}
        class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Volver al inicio
      </a>
      <a
        href={withBase("/productos/")}
        class="inline-flex min-h-12 items-center justify-center rounded-lg border border-steel-200 bg-white px-5 py-3 text-sm font-semibold text-steel-800 transition-colors hover:bg-steel-50"
      >
        Ver catálogo
      </a>
    </div>

    <nav aria-label="Enlaces útiles" class="mt-12 border-t border-steel-200 pt-6">
      <p class="text-sm text-steel-500">También puedes visitar:</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium">
        <li>
          <a href={withBase("/servicios/")} class="text-brand-900 hover:underline">
            Servicios
          </a>
        </li>
        <li>
          <a href={withBase("/nosotros/")} class="text-brand-900 hover:underline">
            Nosotros
          </a>
        </li>
        <li>
          <a href={withBase("/contacto/")} class="text-brand-900 hover:underline">
            Contacto
          </a>
        </li>
        <li>
          <a href={withBase("/preguntas-frecuentes/")} class="text-brand-900 hover:underline">
            Preguntas frecuentes
          </a>
        </li>
      </ul>
    </nav>
  </section>
</BaseLayout>
