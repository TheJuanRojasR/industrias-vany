---
import { getCollection } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import { PRODUCT_CATEGORIES } from "../../config/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );

  return PRODUCT_CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      products: products.filter((product) => product.data.category === category.slug),
    },
  }));
}

const { category, products } = Astro.props;
const sortedProducts = [...products].sort((a, b) => a.data.name.localeCompare(b.data.name, "es"));
const noindex =
  import.meta.env.DEV ||
  sortedProducts.length === 0 ||
  sortedProducts.every(({ data }) => data.sample);
---

<BaseLayout title={category.name} description={category.description} noindex={noindex}>
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-steel-500">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-steel-950">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/productos/" class="hover:text-steel-950">
              Productos
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-steel-700">
            {category.name}
          </li>
        </ol>
      </nav>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Categoría</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
        {category.name}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-steel-600 sm:text-lg">
        {category.description}
      </p>
    </div>
  </section>

  <section
    aria-label={`Productos de ${category.name}`}
    class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8"
  >
    {sortedProducts.length > 0 ? (
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sortedProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </ul>
    ) : (
      <div class="rounded-xl border border-dashed border-steel-300 bg-steel-50 px-6 py-14 text-center">
        <h2 class="font-display text-xl font-semibold text-steel-950">
          Los productos de esta categoría se están cargando
        </h2>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-steel-600">
          Las fichas se publicarán cuando el cliente confirme los modelos y sus detalles.
        </p>
      </div>
    )}

    <a
      href="/productos/"
      class="mt-8 inline-flex min-h-11 items-center justify-center rounded-lg border border-steel-200 bg-white px-4 py-2 text-sm font-semibold text-steel-800 transition-colors hover:bg-steel-50"
    >
      Volver al catálogo
    </a>
  </section>
</BaseLayout>
