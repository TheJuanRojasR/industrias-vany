---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { SITE } from "../../config/site";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const whatsappNumber = SITE.contact.whatsappNumber.replace(/\D/g, "");
const hasWhatsApp = whatsappNumber.length >= 8;
const quoteUrl = buildWhatsAppUrl("Hola, quisiera hacer una consulta.");
const hasContactDetails = Boolean(
  SITE.contact.phone || SITE.contact.email || SITE.contact.address || SITE.contact.hours,
);
const mapUrl = SITE.contact.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.contact.address)}`
  : null;
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contacto",
  description: "Canales de contacto de Industrias Vany.",
  url: canonical.toString(),
};
---

<BaseLayout
  title="Contacto"
  description="Contacta a Industrias Vany para consultar por productos, servicios, mantenimiento o proyectos de equipamiento en acero inoxidable."
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-steel-500">
        <ol class="flex items-center gap-2">
          <li>
            <a href={withBase("/")} class="hover:text-steel-950">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-steel-700">
            Contacto
          </li>
        </ol>
      </nav>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Contacto</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
        Hablemos de tu proyecto
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-steel-600 sm:text-lg">
        Consultanos por productos, servicios, mantenimiento o equipamiento integral. Te respondemos
        por WhatsApp.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div>
        <h2 class="font-display text-2xl font-semibold tracking-tight text-steel-950">
          Canales de contacto
        </h2>

        {hasContactDetails ? (
          <ul class="mt-5 space-y-4 text-sm">
            {quoteUrl && (
              <li>
                <p class="font-medium text-steel-950">WhatsApp</p>
                <a
                  href={quoteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brand-900 hover:underline"
                >
                  Escribir por WhatsApp
                </a>
              </li>
            )}
            {SITE.contact.phone && (
              <li>
                <p class="font-medium text-steel-950">Teléfono</p>
                <a href={`tel:${SITE.contact.phone}`} class="text-brand-900 hover:underline">
                  {SITE.contact.phone}
                </a>
              </li>
            )}
            {SITE.contact.email && (
              <li>
                <p class="font-medium text-steel-950">Email</p>
                <a href={`mailto:${SITE.contact.email}`} class="text-brand-900 hover:underline">
                  {SITE.contact.email}
                </a>
              </li>
            )}
            {SITE.contact.address && (
              <li>
                <p class="font-medium text-steel-950">Dirección</p>
                <p class="mt-1 text-steel-600">{SITE.contact.address}</p>
                {mapUrl && (
                  <a
                    href={mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 inline-flex text-brand-900 hover:underline"
                  >
                    Ver ubicación
                  </a>
                )}
              </li>
            )}
            {SITE.contact.hours && (
              <li>
                <p class="font-medium text-steel-950">Horarios</p>
                <p class="mt-1 text-steel-600">{SITE.contact.hours}</p>
              </li>
            )}
          </ul>
        ) : (
          <p class="mt-5 text-sm leading-6 text-steel-600">
            Los canales de contacto se publicarán próximamente.
          </p>
        )}
      </div>

      <div class="rounded-xl border border-steel-200 bg-white p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold tracking-tight text-steel-950">
          Enviar una consulta
        </h2>
        <p class="mt-2 text-sm leading-6 text-steel-600">
          Completá el formulario y se abrirá WhatsApp con tu mensaje listo para enviar.
        </p>

        <form
          data-contact-form
          data-whatsapp-number={SITE.contact.whatsappNumber}
          class="mt-6 grid gap-4"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="mb-1.5 block text-sm font-medium text-steel-800">
                Nombre completo *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="min-h-11 w-full rounded-lg border border-steel-300 bg-white px-3 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="contact-company" class="mb-1.5 block text-sm font-medium text-steel-800">
                Empresa
              </label>
              <input
                id="contact-company"
                name="company"
                type="text"
                autocomplete="organization"
                class="min-h-11 w-full rounded-lg border border-steel-300 bg-white px-3 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-phone" class="mb-1.5 block text-sm font-medium text-steel-800">
                Teléfono / WhatsApp *
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                class="min-h-11 w-full rounded-lg border border-steel-300 bg-white px-3 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="contact-email" class="mb-1.5 block text-sm font-medium text-steel-800">
                Email
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                class="min-h-11 w-full rounded-lg border border-steel-300 bg-white px-3 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
              />
            </div>
          </div>

          <div>
            <label for="contact-interest" class="mb-1.5 block text-sm font-medium text-steel-800">
              Interés
            </label>
            <select
              id="contact-interest"
              name="interest"
              class="min-h-11 w-full rounded-lg border border-steel-300 bg-white px-3 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
            >
              <option value="">Seleccionar</option>
              <option>Producto</option>
              <option>Servicio</option>
              <option>Mantenimiento</option>
              <option>Fabricación a medida</option>
              <option>Equipamiento integral</option>
              <option>Otro</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="mb-1.5 block text-sm font-medium text-steel-800">
              Mensaje *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              class="w-full rounded-lg border border-steel-300 bg-white px-3 py-2 text-sm text-steel-900 focus:border-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-100"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              disabled={!hasWhatsApp}
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-steel-300 disabled:text-steel-600"
            >
              Enviar por WhatsApp
            </button>
            <p data-contact-status aria-live="polite" class="text-sm text-steel-600"></p>
          </div>

          {!hasWhatsApp && (
            <p class="text-xs text-steel-500">
              El envío por WhatsApp se habilitará cuando se configure el número.
            </p>
          )}

          <p class="text-xs leading-5 text-steel-500">
            Al enviar, se abrirá WhatsApp con tu mensaje. No se almacena en este sitio. Consulta la{" "}
            <a href={withBase("/politica-de-privacidad/")} class="underline hover:text-brand-900">
              política de privacidad
            </a>
            .
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    import "../../scripts/contact-form";
  </script>
</BaseLayout>
