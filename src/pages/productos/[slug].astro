---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import ProductCard from "../../components/ProductCard.astro";
import { getCategoryName, getCoolingTypeName, getProductTypeName } from "../../config/catalog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildProductSchema } from "../../lib/structured-data";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

interface Props {
  product: CollectionEntry<"products">;
  relatedProducts: CollectionEntry<"products">[];
}

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );

  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      relatedProducts: products
        .filter(
          (relatedProduct) =>
            relatedProduct.id !== product.id &&
            relatedProduct.data.category === product.data.category,
        )
        .slice(0, 3),
    },
  }));
}

const { product, relatedProducts } = Astro.props;
const { Content } = await render(product);
const categoryName = getCategoryName(product.data.category);
const productTypeName = getProductTypeName(product.data.productType);
const coolingTypeNames = product.data.coolingTypes.map(getCoolingTypeName);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const quoteUrl = buildWhatsAppUrl(
  `Hola, me interesa cotizar el producto "${product.data.name}". ¿Podrían darme más información?`,
);
const noindex = product.data.sample || import.meta.env.DEV;

const schemaImages = await Promise.all(
  product.data.images.map(async (image) => {
    const optimized = await getImage({
      src: image.src,
      width: 1200,
      format: "webp",
    });

    return new URL(optimized.src, canonical).toString();
  }),
);

const productSchema = buildProductSchema({
  name: product.data.name,
  description: product.data.description,
  category: categoryName,
  productType: productTypeName,
  url: canonical.toString(),
  images: schemaImages,
  reference: product.data.reference,
});

const categoryUrl = new URL(`/categorias/${product.data.category}/`, canonical).toString();
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Inicio", url: new URL("/", canonical).toString() },
  { name: "Productos", url: new URL("/productos/", canonical).toString() },
  { name: categoryName, url: categoryUrl },
  { name: product.data.name, url: canonical.toString() },
]);
---

<BaseLayout
  title={product.data.seo?.title ?? product.data.name}
  description={product.data.seo?.description ?? product.data.summary}
  image={schemaImages[0]}
  noindex={noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <nav aria-label="Migas de pan" class="text-sm text-steel-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-steel-950">
            Inicio
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/productos/" class="hover:text-steel-950">
            Productos
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/categorias/${product.data.category}/`} class="hover:text-steel-950">
            {categoryName}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-steel-700">
          {product.data.name}
        </li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-4">
        {product.data.images.length > 0 ? (
          product.data.images.map((image, index) => (
            <div class="overflow-hidden rounded-xl border border-steel-200 bg-steel-100">
              <Image
                src={image.src}
                alt={image.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading={index === 0 ? "eager" : "lazy"}
                class="h-auto w-full object-cover"
              />
            </div>
          ))
        ) : (
          <div
            role="img"
            aria-label={`Imagen pendiente para ${product.data.name}`}
            class="flex aspect-[4/3] items-center justify-center rounded-xl border border-steel-200 bg-gradient-to-br from-steel-100 via-white to-brand-50"
          >
            <span class="font-display text-sm font-medium text-steel-500">Imagen pendiente</span>
          </div>
        )}
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`/categorias/${product.data.category}/`}
            class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700 hover:text-brand-900"
          >
            {categoryName}
          </a>
          {product.data.sample && (
            <span class="rounded-full bg-amber-50 px-2 py-1 text-[0.65rem] font-semibold text-amber-800">
              Ejemplo · pendiente
            </span>
          )}
        </div>

        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
          {product.data.name}
        </h1>
        <p class="mt-4 text-lg leading-8 text-steel-600">{product.data.summary}</p>

        <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
          <div>
            <dt class="text-steel-500">Tipo de producto</dt>
            <dd class="font-medium text-steel-900">{productTypeName}</dd>
          </div>
          {product.data.reference && (
            <div>
              <dt class="text-steel-500">Referencia</dt>
              <dd class="font-medium text-steel-900">{product.data.reference}</dd>
            </div>
          )}
        </dl>

        {coolingTypeNames.length > 0 && (
          <ul aria-label="Tipos de frío disponibles" class="mt-5 flex flex-wrap gap-2">
            {coolingTypeNames.map((coolingType) => (
              <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-900">
                {coolingType}
              </li>
            ))}
          </ul>
        )}

        <div class="mt-8 flex flex-wrap items-center gap-3">
          {quoteUrl ? (
            <a
              href={quoteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
            >
              Cotizar por WhatsApp
            </a>
          ) : import.meta.env.DEV ? (
            <span class="rounded-lg bg-steel-100 px-4 py-3 text-sm font-medium text-steel-600">
              WhatsApp pendiente de configurar
            </span>
          ) : null}
          <a
            href="/productos/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-steel-200 bg-white px-5 py-3 text-sm font-semibold text-steel-800 transition-colors hover:bg-steel-50"
          >
            Volver al catálogo
          </a>
        </div>

        <p class="mt-3 text-xs text-steel-500">
          Sin precio publicado. Todos los productos se cotizan.
        </p>
      </div>
    </div>

    {product.data.specs.length > 0 && (
      <section aria-labelledby="specs-title" class="mt-12 border-t border-steel-200 pt-10">
        <h2 id="specs-title" class="font-display text-2xl font-semibold text-steel-950">
          Especificaciones
        </h2>
        <dl class="mt-4 divide-y divide-steel-200 rounded-xl border border-steel-200">
          {product.data.specs.map((spec) => (
            <div class="grid gap-1 px-4 py-3 sm:grid-cols-2 sm:gap-4">
              <dt class="text-sm font-medium text-steel-600">{spec.label}</dt>
              <dd class="text-sm text-steel-950">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {product.data.features.length > 0 && (
      <section aria-labelledby="features-title" class="mt-10">
        <h2 id="features-title" class="font-display text-2xl font-semibold text-steel-950">
          Características
        </h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {product.data.features.map((feature) => (
            <li class="flex gap-3 text-sm leading-6 text-steel-700">
              <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {product.data.applications.length > 0 && (
      <section aria-labelledby="applications-title" class="mt-10">
        <h2 id="applications-title" class="font-display text-2xl font-semibold text-steel-950">
          Aplicaciones
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {product.data.applications.map((application) => (
            <li class="rounded-full bg-steel-100 px-3 py-1 text-sm text-steel-700">
              {application}
            </li>
          ))}
        </ul>
      </section>
    )}

    {product.data.warranty && (
      <section
        aria-labelledby="warranty-title"
        class="mt-10 rounded-xl border border-steel-200 bg-steel-50 p-5"
      >
        <h2 id="warranty-title" class="font-display text-lg font-semibold text-steel-950">
          Garantía
        </h2>
        <p class="mt-2 text-sm leading-6 text-steel-600">{product.data.warranty}</p>
      </section>
    )}

    <div class="prose-content mt-12 max-w-none">
      <Content />
    </div>

    {relatedProducts.length > 0 && (
      <section aria-labelledby="related-title" class="mt-16 border-t border-steel-200 pt-10">
        <h2 id="related-title" class="font-display text-2xl font-semibold text-steel-950">
          Productos relacionados
        </h2>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedProducts.map((relatedProduct) => (
            <ProductCard product={relatedProduct} />
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
