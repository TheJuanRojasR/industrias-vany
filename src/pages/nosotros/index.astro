---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const quoteUrl = buildWhatsAppUrl(
  "Hola, quisiera conocer más sobre Industrias Vany y el equipamiento que ofrecen.",
);
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Nosotros",
  description:
    "Industrias Vany crea equipos industriales en acero inoxidable y acompaña proyectos de equipamiento para cocinas profesionales.",
  url: canonical.toString(),
};
---

<BaseLayout
  title="Nosotros"
  description="Conoce Industrias Vany: equipos industriales en acero inoxidable, fabricación a medida y acompañamiento para proyectos de cocinas profesionales."
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-steel-500">
        <ol class="flex items-center gap-2">
          <li>
            <a href={withBase("/")} class="hover:text-steel-950">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-steel-700">
            Nosotros
          </li>
        </ol>
      </nav>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Nosotros</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-steel-950 sm:text-5xl">
        Equipamiento industrial con acompañamiento directo
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-steel-600 sm:text-lg">
        Industrias Vany crea equipos industriales en acero inoxidable y acompaña a sus clientes en
        la definición, fabricación, instalación y mantenimiento del equipamiento.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">
          Quiénes somos
        </p>
        <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-steel-950 sm:text-3xl">
          Equipos para cocinas que trabajan todos los días
        </h2>
      </div>
      <div class="space-y-4 text-base leading-7 text-steel-600">
        <p>
          Somos una empresa dedicada a la creación de equipos industriales en acero inoxidable:
          hornos, neveras, freidoras, estufas, campanas, mesones y otras soluciones para cocinas
          profesionales.
        </p>
        <p>
          Trabajamos con negocios gastronómicos, hoteles, panaderías, instituciones y proyectos que
          necesitan equipamiento adaptado a su espacio y a su operación.
        </p>
      </div>
    </div>

    <section aria-labelledby="what-we-do-title" class="mt-12 border-t border-steel-200 pt-10">
      <h2
        id="what-we-do-title"
        class="font-display text-2xl font-semibold tracking-tight text-steel-950"
      >
        Qué hacemos
      </h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div>
          <h3 class="font-display text-lg font-semibold text-steel-950">Equipamiento</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {["Refrigeración", "Cocción", "Extracción", "Mobiliario", "Fabricación a medida"].map(
              (item) => (
                <li class="rounded-full bg-steel-100 px-3 py-1 text-sm text-steel-700">{item}</li>
              ),
            )}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-steel-950">Servicios</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {[
              "Instalación",
              "Mantenimiento",
              "Asesoría y diseño",
              "Equipamiento integral",
              "Repuestos",
            ].map((item) => (
              <li class="rounded-full bg-brand-50 px-3 py-1 text-sm text-brand-900">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="approach-title" class="mt-12 border-t border-steel-200 pt-10">
      <h2
        id="approach-title"
        class="font-display text-2xl font-semibold tracking-tight text-steel-950"
      >
        Nuestro enfoque
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {[
          {
            title: "Acero inoxidable",
            description:
              "Equipamiento pensado para el uso intensivo y la limpieza que exige una cocina profesional.",
          },
          {
            title: "Atención directa",
            description:
              "Acompañamos la consulta y la definición del proyecto de forma cercana y clara.",
          },
          {
            title: "Soluciones según el proyecto",
            description:
              "Adaptamos el equipamiento al espacio y a las necesidades de cada operación.",
          },
        ].map((item) => (
          <article class="rounded-xl border border-steel-200 bg-white p-5">
            <h3 class="font-display text-lg font-semibold text-steel-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="process-title" class="mt-12 border-t border-steel-200 pt-10">
      <h2
        id="process-title"
        class="font-display text-2xl font-semibold tracking-tight text-steel-950"
      >
        Cómo trabajamos
      </h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            title: "Escuchamos",
            description: "Conocemos la necesidad, el espacio y la operación del cliente.",
          },
          {
            title: "Definimos",
            description: "Revisamos el equipamiento y los detalles del proyecto.",
          },
          {
            title: "Fabricamos",
            description: "Producimos o coordinamos el equipamiento necesario.",
          },
          {
            title: "Acompañamos",
            description: "Seguimos el proyecto hasta la entrega y la puesta en marcha.",
          },
        ].map((step, index) => (
          <li class="rounded-xl border border-steel-200 bg-steel-50 p-5">
            <p class="font-display text-sm font-semibold text-brand-700">0{index + 1}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-steel-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-steel-600">{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="mt-10 rounded-xl border border-steel-200 bg-white p-6 sm:p-8">
      <h2 class="font-display text-xl font-semibold text-steel-950">
        ¿Quieres conocer más sobre Industrias Vany?
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-steel-600">
        Escríbenos y te contamos cómo podemos acompañar tu proyecto de equipamiento.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        {quoteUrl ? (
          <a
            href={quoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-brand-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Consultar por WhatsApp
          </a>
        ) : import.meta.env.DEV ? (
          <span class="rounded-lg bg-steel-100 px-4 py-3 text-sm font-medium text-steel-600">
            WhatsApp pendiente de configurar
          </span>
        ) : null}
        <a
          href={withBase("/servicios/")}
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-steel-200 bg-white px-5 py-3 text-sm font-semibold text-steel-800 transition-colors hover:bg-steel-50"
        >
          Conocer servicios
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
