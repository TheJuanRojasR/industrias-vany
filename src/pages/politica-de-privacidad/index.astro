---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entry = await getEntry("legal", "politica-de-privacidad");

if (!entry) {
  throw new Error("No se encontró la política de privacidad.");
}

const { Content } = await render(entry);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: entry.data.title,
  description: entry.data.description,
  url: canonical.toString(),
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} noindex>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <nav aria-label="Migas de pan" class="text-sm text-steel-500">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-steel-950">
            Inicio
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-steel-700">
          Política de privacidad
        </li>
      </ol>
    </nav>

    <div class="mt-8 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">
      Documento en revisión. Los datos marcados como <code>[PENDIENTE]</code> y la revisión legal se
      completarán antes de la publicación.
    </div>

    <header class="mt-8 border-b border-steel-200 pb-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Legal</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-steel-950 sm:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-3 text-sm text-steel-500">
        Última actualización: {entry.data.updated ?? "Pendiente de confirmar"}
      </p>
    </header>

    <div class="prose-content mt-8 max-w-none">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-3 border-t border-steel-200 pt-6">
      <a
        href="/contacto/"
        class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Ir a Contacto
      </a>
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center rounded-lg border border-steel-200 bg-white px-4 py-2 text-sm font-semibold text-steel-800 transition-colors hover:bg-steel-50"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
