---
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

const year = new Date().getFullYear();
const hasContactDetails = Boolean(SITE.contact.email || SITE.contact.phone || SITE.contact.address);
const showContactColumn = hasContactDetails || import.meta.env.DEV;
---

<footer class="border-t border-steel-200 bg-steel-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <p class="font-display text-lg font-semibold tracking-tight text-steel-950">{SITE.name}</p>
        <p class="mt-3 max-w-md text-sm leading-6 text-steel-600">{SITE.description}</p>
      </div>

      <nav aria-label="Enlaces del sitio">
        <h2 class="text-sm font-semibold text-steel-950">Sitio</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={withBase("/nosotros/")} class="text-steel-600 hover:text-brand-900">
              Nosotros
            </a>
          </li>
          <li>
            <a href={withBase("/servicios/")} class="text-steel-600 hover:text-brand-900">
              Servicios
            </a>
          </li>
          <li>
            <a href={withBase("/productos/")} class="text-steel-600 hover:text-brand-900">
              Productos
            </a>
          </li>
          <li>
            <a
              href={withBase("/preguntas-frecuentes/")}
              class="text-steel-600 hover:text-brand-900"
            >
              Preguntas frecuentes
            </a>
          </li>
        </ul>
      </nav>

      {showContactColumn && (
        <div>
          <h2 class="text-sm font-semibold text-steel-950">Contacto</h2>
          <ul class="mt-3 space-y-2 text-sm text-steel-600">
            {SITE.contact.email ? (
              <li>
                <a href={`mailto:${SITE.contact.email}`} class="hover:text-brand-900">
                  {SITE.contact.email}
                </a>
              </li>
            ) : import.meta.env.DEV ? (
              <li>Correo pendiente de confirmar</li>
            ) : null}
            {SITE.contact.phone ? (
              <li>{SITE.contact.phone}</li>
            ) : import.meta.env.DEV ? (
              <li>Teléfono pendiente de confirmar</li>
            ) : null}
            {SITE.contact.address && <li>{SITE.contact.address}</li>}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-steel-200 pt-5 pb-24 text-xs text-steel-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {SITE.name}. Todos los derechos reservados.
      </p>
      <a href={withBase("/politica-de-privacidad/")} class="hover:text-brand-900">
        Política de privacidad
      </a>
    </div>
  </div>
</footer>
