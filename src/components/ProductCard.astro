---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCategoryName, getCoolingTypeName, getProductTypeName } from "../config/catalog";
import { buildWhatsAppUrl } from "../lib/whatsapp";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const image = product.data.images[0];
const categoryName = getCategoryName(product.data.category);
const productTypeName = getProductTypeName(product.data.productType);
const coolingTypeNames = product.data.coolingTypes.map(getCoolingTypeName);
const searchText = [
  product.data.name,
  product.data.summary,
  product.data.reference ?? "",
  categoryName,
  productTypeName,
  ...coolingTypeNames,
].join(" ");
const quoteUrl = buildWhatsAppUrl(`Hola, me interesa cotizar el producto ${product.data.name}.`);
---

<li
  data-product-card
  data-search={searchText}
  data-category={product.data.category}
  data-product-type={product.data.productType}
  data-cooling-types={product.data.coolingTypes.join(" ")}
  class="h-full"
>
  <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-steel-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-steel-300 hover:shadow-md motion-reduce:transform-none motion-reduce:transition-none">
    <div class="aspect-[4/3] overflow-hidden bg-steel-100">
      {image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none"
        />
      ) : (
        <div
          role="img"
          aria-label={`Imagen pendiente para ${product.data.name}`}
          class="flex h-full items-center justify-center bg-gradient-to-br from-steel-100 via-white to-brand-50"
        >
          <span class="font-display text-sm font-medium text-steel-500">Imagen pendiente</span>
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">
          {categoryName}
        </span>
        {product.data.sample && (
          <span class="rounded-full bg-amber-50 px-2 py-1 text-[0.65rem] font-semibold text-amber-800">
            Ejemplo · pendiente
          </span>
        )}
      </div>

      <h2 class="mt-2 font-display text-lg font-semibold text-steel-950">{product.data.name}</h2>
      <p class="mt-2 text-sm leading-6 text-steel-600">{product.data.summary}</p>

      {coolingTypeNames.length > 0 && (
        <ul aria-label="Tipos de frío disponibles" class="mt-4 flex flex-wrap gap-2">
          {coolingTypeNames.map((coolingType) => (
            <li class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-900">
              {coolingType}
            </li>
          ))}
        </ul>
      )}

      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-steel-100 pt-4">
        <span class="text-xs font-medium text-steel-600">Sin precio publicado</span>
        {quoteUrl ? (
          <a
            href={quoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-brand-900 underline-offset-4 hover:underline"
          >
            Cotizar por WhatsApp
          </a>
        ) : import.meta.env.DEV ? (
          <span class="text-xs font-medium text-steel-500">WhatsApp pendiente</span>
        ) : null}
      </div>

      <p class="mt-3 text-xs text-steel-500">
        La ficha detallada se agregará en el siguiente paso.
      </p>
    </div>
  </article>
</li>
