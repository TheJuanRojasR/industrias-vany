---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-provisional.jpeg";
import { SITE } from "../config/site";

const navigation = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros/", label: "Nosotros" },
  { href: "/servicios/", label: "Servicios" },
  { href: "/productos/", label: "Productos" },
] as const;

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-steel-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex min-h-[4.5rem] max-w-6xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" aria-label={`${SITE.name} — Inicio`} class="shrink-0">
      <Image src={logo} alt="" width={270} height={88} class="h-12 w-auto object-contain" />
    </a>

    <nav aria-label="Navegación principal" class="flex items-center gap-3">
      <ul class="hidden items-center gap-1 md:flex">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                isActive(item.href)
                  ? "bg-steel-100 text-steel-950"
                  : "text-steel-600 hover:bg-steel-50 hover:text-brand-900",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/contacto/"
        class="hidden min-h-11 items-center justify-center rounded-lg bg-brand-900 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-700 sm:inline-flex"
      >
        Contactar
      </a>

      <details class="relative md:hidden">
        <summary
          aria-label="Abrir navegación"
          class="flex size-11 cursor-pointer items-center justify-center rounded-lg border border-steel-200 text-steel-800 hover:bg-steel-50"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </summary>
        <ul class="absolute right-0 top-full mt-2 grid min-w-48 gap-1 rounded-xl border border-steel-200 bg-white p-2 shadow-lg">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-lg px-3 py-2.5 text-sm font-medium",
                  isActive(item.href)
                    ? "bg-steel-100 text-steel-950"
                    : "text-steel-700 hover:bg-steel-50 hover:text-brand-900",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="sm:hidden">
            <a
              href="/contacto/"
              class="mt-1 block rounded-lg bg-brand-900 px-3 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-700"
            >
              Contactar
            </a>
          </li>
        </ul>
      </details>
    </nav>
  </div>
</header>
